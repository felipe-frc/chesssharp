<Window x:Class="ChessSharp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChessSharp - Premium Edition"
        Width="1200"
        Height="850"
        MinWidth="1000"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#050403"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

        <Window.Resources>
                <!-- Paleta -->
                <SolidColorBrush x:Key="GoldAccent"
                                Color="#D6A23F"/>
                <SolidColorBrush x:Key="GoldSoft"
                                Color="#E0B85C"/>
                <SolidColorBrush x:Key="BronzeSoft"
                                Color="#9A6A2E"/>
                <SolidColorBrush x:Key="TextWhite"
                                Color="#F3E7D5"/>

                <!-- Botão premium sutil -->
                <Style x:Key="PremiumFooterButtonStyle"
                       TargetType="Button">
                        <Setter Property="Foreground"
                                        Value="{StaticResource TextWhite}"/>
                        <Setter Property="Background"
                                        Value="#120A07"/>
                        <Setter Property="BorderBrush"
                                        Value="#8C6630"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="FontSize"
                                        Value="13"/>
                        <Setter Property="FontFamily"
                                        Value="Segoe UI"/>
                        <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                        <Setter Property="Cursor"
                                        Value="Hand"/>
                        <Setter Property="Height"
                                        Value="36"/>
                        <Setter Property="Padding"
                                        Value="18,0"/>
                        <Setter Property="Margin"
                                        Value="10,0,0,0"/>

                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5"
                                                        SnapsToDevicePixels="True">
                                                        <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                     EndPoint="0,1">
                                                                        <GradientStop Color="#24150E"
                                                                                        Offset="0"/>
                                                                        <GradientStop Color="#140C08"
                                                                                        Offset="0.48"/>
                                                                        <GradientStop Color="#0A0604"
                                                                                        Offset="1"/>
                                                                </LinearGradientBrush>
                                                        </Border.Background>

                                                        <Grid ClipToBounds="True">
                                                                <!-- brilho superior bem sutil -->
                                                                <Rectangle Height="1"
                                                                           VerticalAlignment="Top"
                                                                           Margin="9,0,9,0"
                                                                           Opacity="0.75">
                                                                        <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                                     EndPoint="1,0">
                                                                                        <GradientStop Color="#00D6A23F"
                                                                                                        Offset="0"/>
                                                                                        <GradientStop Color="#88E0B85C"
                                                                                                        Offset="0.5"/>
                                                                                        <GradientStop Color="#00D6A23F"
                                                                                                        Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                        </Rectangle.Fill>
                                                                </Rectangle>

                                                                <!-- profundidade interna -->
                                                                <Rectangle RadiusX="5"
                                                                           RadiusY="5"
                                                                           Opacity="0.18">
                                                                        <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                                     EndPoint="1,1">
                                                                                        <GradientStop Color="#22FFFFFF"
                                                                                                        Offset="0"/>
                                                                                        <GradientStop Color="#00000000"
                                                                                                        Offset="0.55"/>
                                                                                        <GradientStop Color="#22D6A23F"
                                                                                                        Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                        </Rectangle.Fill>
                                                                </Rectangle>

                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                        </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="{StaticResource GoldAccent}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource GoldSoft}"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                        Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="#FFF1C2"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="PromotionChoiceButtonStyle"
                       TargetType="Button">
                        <Setter Property="Width"
                                        Value="118"/>
                        <Setter Property="Height"
                                        Value="148"/>
                        <Setter Property="Margin"
                                        Value="8,0"/>
                        <Setter Property="Padding"
                                        Value="10"/>
                        <Setter Property="Cursor"
                                        Value="Hand"/>
                        <Setter Property="Foreground"
                                        Value="{StaticResource TextWhite}"/>
                        <Setter Property="Background"
                                        Value="#120A07"/>
                        <Setter Property="BorderBrush"
                                        Value="#8C6630"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        SnapsToDevicePixels="True">
                                                        <Border.Effect>
                                                                <DropShadowEffect Color="#D6A23F"
                                                                                  BlurRadius="14"
                                                                                  ShadowDepth="0"
                                                                                  Opacity="0.12"/>
                                                        </Border.Effect>

                                                        <Grid ClipToBounds="True">
                                                                <Rectangle RadiusX="8"
                                                                           RadiusY="8"
                                                                           Opacity="0.16">
                                                                        <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                                     EndPoint="1,1">
                                                                                        <GradientStop Color="#22FFFFFF"
                                                                                                        Offset="0"/>
                                                                                        <GradientStop Color="#00000000"
                                                                                                        Offset="0.55"/>
                                                                                        <GradientStop Color="#22D6A23F"
                                                                                                        Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                        </Rectangle.Fill>
                                                                </Rectangle>

                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                        </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                        Property="BorderBrush"
                                                                        Value="{StaticResource GoldAccent}"/>
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource GoldSoft}"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                        Value="True">
                                                                <Setter Property="Foreground"
                                                                        Value="#FFF1C2"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <Style x:Key="ColorChoiceButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource PromotionChoiceButtonStyle}">
                        <Setter Property="Width"
                                        Value="180"/>
                        <Setter Property="Height"
                                        Value="168"/>
                </Style>
        </Window.Resources>

        <Grid>
                <!-- Background -->
                <Grid.Background>
                        <ImageBrush ImageSource="/Assets/Images/background-marble.png"
                                    Stretch="UniformToFill"
                                    AlignmentX="Center"
                                    AlignmentY="Center"/>
                </Grid.Background>

                <!-- Camada escura -->
                <Rectangle Fill="#66000000"
                           IsHitTestVisible="False"/>

                <!-- Vinheta -->
                <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                                <RadialGradientBrush Center="0.5,0.42"
                                                     RadiusX="0.95"
                                                     RadiusY="0.95">
                                        <GradientStop Color="#00000000"
                                                        Offset="0"/>
                                        <GradientStop Color="#33000000"
                                                        Offset="0.62"/>
                                        <GradientStop Color="#99000000"
                                                        Offset="1"/>
                                </RadialGradientBrush>
                        </Rectangle.Fill>
                </Rectangle>

                <!-- Moldura externa -->
                <Border BorderBrush="{StaticResource BronzeSoft}"
                        BorderThickness="0.5"
                        Margin="15"
                        Opacity="0.35"
                        CornerRadius="2"/>

                <Grid Margin="32,22,32,28">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,16,0,20">
                                <Image Source="pack://application:,,,/Assets/Images/logo-chesssharp.png"
                                       Width="300"
                                       Height="82"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                        </StackPanel>

                        <!-- BOARD -->
                        <Viewbox Grid.Row="1"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="0,12,0,0">
                                <Border Padding="0"
                                        Background="#060504"
                                        BorderBrush="{StaticResource GoldAccent}"
                                        BorderThickness="0"
                                        CornerRadius="8">
                                        <Border.Effect>
                                                <DropShadowEffect Color="#D6A23F"
                                                                  BlurRadius="24"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.22"/>
                                        </Border.Effect>

                                        <Grid Width="760"
                                              Height="760"
                                              ClipToBounds="True"
                                              SnapsToDevicePixels="True">

                                                <Image Source="/Assets/Images/board-premium.png"
                                                       Width="760"
                                                       Height="760"
                                                       Stretch="Fill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <Grid x:Name="BoardGrid"
                                                      Width="656"
                                                      Height="656"
                                                      Margin="52,52,52,52"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Background="#01FFFFFF"
                                                      ClipToBounds="True"/>
                                        </Grid>
                                </Border>
                        </Viewbox>

                        <!-- FOOTER PREMIUM SUTIL -->
                        <Grid Grid.Row="2"
                              Margin="0,16,0,0"
                              HorizontalAlignment="Center">

                                <Border Width="930"
                                        Height="58"
                                        Background="#C80F0806"
                                        BorderBrush="#80602F"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Border.Effect>
                                                <DropShadowEffect Color="#D6A23F"
                                                                  BlurRadius="10"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.12"/>
                                        </Border.Effect>

                                        <Grid>
                                                <!-- brilho superior da barra -->
                                                <Rectangle Height="1"
                                                           VerticalAlignment="Top"
                                                           Margin="18,0,18,0"
                                                           Opacity="0.7">
                                                        <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                     EndPoint="1,0">
                                                                        <GradientStop Color="#00D6A23F"
                                                                                        Offset="0"/>
                                                                        <GradientStop Color="#99E0B85C"
                                                                                        Offset="0.5"/>
                                                                        <GradientStop Color="#00D6A23F"
                                                                                        Offset="1"/>
                                                                </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                </Rectangle>

                                                <Grid Margin="18,0">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- STATUS -->
                                                        <Grid Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- indicador discreto -->
                                                                <Grid Width="28"
                                                                      Height="28"
                                                                      VerticalAlignment="Center">
                                                                        <Ellipse Fill="#1A100B"
                                                                                 Stroke="#80602F"
                                                                                 StrokeThickness="1"/>
                                                                        <Ellipse Width="7"
                                                                                 Height="7"
                                                                                 Fill="{StaticResource GoldSoft}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center">
                                                                                <Ellipse.Effect>
                                                                                        <DropShadowEffect Color="#E0B85C"
                                                                                                          BlurRadius="7"
                                                                                                          ShadowDepth="0"
                                                                                                          Opacity="0.65"/>
                                                                                </Ellipse.Effect>
                                                                        </Ellipse>
                                                                </Grid>

                                                                <Rectangle Grid.Column="1"
                                                                           Width="1"
                                                                           Height="30"
                                                                           Fill="#4A3520"
                                                                           Margin="14,0,16,0"
                                                                           VerticalAlignment="Center"/>

                                                                <StackPanel Grid.Column="2"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="STATUS DA PARTIDA"
                                                                                   Foreground="{StaticResource GoldAccent}"
                                                                                   FontSize="9"
                                                                                   FontWeight="Bold"
                                                                                   Margin="0,0,0,2"/>

                                                                        <TextBlock x:Name="StatusText"
                                                                                   Text="AGUARDANDO INÍCIO..."
                                                                                   Foreground="{StaticResource TextWhite}"
                                                                                   FontSize="16"
                                                                                   FontFamily="Segoe UI Light"/>
                                                                </StackPanel>
                                                        </Grid>

                                                        <!-- BOTÕES -->
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">

                                                                <Button Style="{StaticResource PremiumFooterButtonStyle}"
                                                                        Click="NewGameButton_Click"
                                                                        Width="145"
                                                                        Height="36">
                                                                        <TextBlock Text="NEW GAME"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"/>
                                                                </Button>

                                                                <Button Style="{StaticResource PremiumFooterButtonStyle}"
                                                                        Click="ExitButton_Click"
                                                                        Width="105"
                                                                        Height="36">
                                                                        <TextBlock Text="EXIT"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"/>
                                                                </Button>
                                                        </StackPanel>
                                                </Grid>
                                        </Grid>
                                </Border>
                        </Grid>
                </Grid>

                <Grid x:Name="ColorSelectionOverlay"
                      Visibility="Collapsed"
                      Background="#90000000">
                        <Border Width="520"
                                Padding="28,24,28,28"
                                Background="#E10F0806"
                                BorderBrush="{StaticResource GoldAccent}"
                                BorderThickness="1"
                                CornerRadius="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border.Effect>
                                        <DropShadowEffect Color="#D6A23F"
                                                          BlurRadius="26"
                                                          ShadowDepth="0"
                                                          Opacity="0.22"/>
                                </Border.Effect>

                                <StackPanel>
                                        <TextBlock Text="ESCOLHA SUA COR"
                                                   Foreground="{StaticResource GoldAccent}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="Defina quem faz a primeira jogada"
                                                   Foreground="{StaticResource TextWhite}"
                                                   FontSize="18"
                                                   Margin="0,8,0,22"
                                                   HorizontalAlignment="Center"/>

                                        <UniformGrid Columns="2"
                                                     HorizontalAlignment="Center">
                                                <Button x:Name="ChooseWhiteButton"
                                                        Style="{StaticResource ColorChoiceButtonStyle}"
                                                        Tag="White"
                                                        Click="ColorOptionButton_Click"/>

                                                <Button x:Name="ChooseBlackButton"
                                                        Style="{StaticResource ColorChoiceButtonStyle}"
                                                        Tag="Black"
                                                        Click="ColorOptionButton_Click"/>
                                        </UniformGrid>
                                </StackPanel>
                        </Border>
                </Grid>

                <Grid x:Name="PromotionOverlay"
                      Visibility="Collapsed"
                      Background="#90000000">
                        <Border Width="640"
                                Padding="28,24,28,28"
                                Background="#E10F0806"
                                BorderBrush="{StaticResource GoldAccent}"
                                BorderThickness="1"
                                CornerRadius="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Border.Effect>
                                        <DropShadowEffect Color="#D6A23F"
                                                          BlurRadius="26"
                                                          ShadowDepth="0"
                                                          Opacity="0.22"/>
                                </Border.Effect>

                                <StackPanel>
                                        <TextBlock Text="PROMOÇÃO DE PEÃO"
                                                   Foreground="{StaticResource GoldAccent}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="Escolha a peça para concluir a jogada"
                                                   Foreground="{StaticResource TextWhite}"
                                                   FontSize="18"
                                                   Margin="0,8,0,22"
                                                   HorizontalAlignment="Center"/>

                                        <UniformGrid Columns="4"
                                                     HorizontalAlignment="Center">
                                                <Button x:Name="PromotionQueenButton"
                                                        Style="{StaticResource PromotionChoiceButtonStyle}"
                                                        Tag="Queen"
                                                        Click="PromotionOptionButton_Click"/>

                                                <Button x:Name="PromotionRookButton"
                                                        Style="{StaticResource PromotionChoiceButtonStyle}"
                                                        Tag="Rook"
                                                        Click="PromotionOptionButton_Click"/>

                                                <Button x:Name="PromotionBishopButton"
                                                        Style="{StaticResource PromotionChoiceButtonStyle}"
                                                        Tag="Bishop"
                                                        Click="PromotionOptionButton_Click"/>

                                                <Button x:Name="PromotionKnightButton"
                                                        Style="{StaticResource PromotionChoiceButtonStyle}"
                                                        Tag="Knight"
                                                        Click="PromotionOptionButton_Click"/>
                                        </UniformGrid>
                                </StackPanel>
                        </Border>
                </Grid>
        </Grid>
</Window>
