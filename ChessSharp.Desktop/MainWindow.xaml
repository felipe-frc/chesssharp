<Window x:Class="ChessSharp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChessSharp - Premium Edition"
        Width="1200"
        Height="850"
        MinWidth="1000"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#160B08">

    <Window.Resources>
        <!-- Paleta premium madeira / dourado / off-white -->
        <SolidColorBrush x:Key="GoldAccent"
                         Color="#D6A23F"/>
        <SolidColorBrush x:Key="GoldSoft"
                         Color="#E0B85C"/>
        <SolidColorBrush x:Key="BronzeSoft"
                         Color="#9A6A2E"/>
        <SolidColorBrush x:Key="WoodDark"
                         Color="#1A0B07"/>
        <SolidColorBrush x:Key="WoodMedium"
                         Color="#2A120D"/>
        <SolidColorBrush x:Key="WoodSoft"
                         Color="#3B1A11"/>
        <SolidColorBrush x:Key="TextWhite"
                         Color="#F3E7D5"/>
        <SolidColorBrush x:Key="TextMuted"
                         Color="#E8D6B0"/>
        <SolidColorBrush x:Key="TextGold"
                         Color="#E0B85C"/>

        <!-- Estilo para as coordenadas -->
        <Style x:Key="CoordinateTextStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Opacity"
                    Value="0.78"/>
        </Style>

        <!-- Estilo para botões modernos -->
        <Style x:Key="ModernButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="{StaticResource TextWhite}"/>
            <Setter Property="Background"
                    Value="#24100A"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource GoldAccent}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="20,10"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontFamily"
                    Value="Segoe UI"/>
            <Setter Property="FontWeight"
                    Value="Medium"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="MinWidth"
                    Value="130"/>
            <Setter Property="Height"
                    Value="45"/>
            <Setter Property="Margin"
                    Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#32170D"/>
                    <Setter Property="BorderBrush"
                            Value="{StaticResource GoldSoft}"/>
                    <Setter Property="Foreground"
                            Value="{StaticResource GoldSoft}"/>
                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">
                    <Setter Property="Background"
                            Value="#4A2412"/>
                    <Setter Property="Foreground"
                            Value="#FFF1C2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background menos preto, mais madeira escura -->
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.45"
                                 RadiusX="1"
                                 RadiusY="1">
                <GradientStop Color="#2A120D"
                              Offset="0"/>
                <GradientStop Color="#1A0B07"
                              Offset="0.62"/>
                <GradientStop Color="#0E0503"
                              Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- Moldura decorativa sutil -->
        <Border BorderBrush="{StaticResource BronzeSoft}"
                BorderThickness="0.5"
                Margin="15"
                Opacity="0.35"
                CornerRadius="2"/>

        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,30">
                <Image Source="pack://application:,,,/Assets/Images/logo-chesssharp.png"
                       Width="350"
                       Height="120"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <Rectangle Height="1"
                           Width="200"
                           Fill="{StaticResource GoldAccent}"
                           Margin="0,10,0,10"
                           Opacity="0.5"/>

                <TextBlock Text="PREMIUM STRATEGY EXPERIENCE"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           FontWeight="Light"
                           HorizontalAlignment="Center"
                           Opacity="0.65"/>
            </StackPanel>

            <!-- BOARD AREA -->
            <Viewbox Grid.Row="1"
                     Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Border Padding="20"
                        Background="#160B08"
                        BorderBrush="{StaticResource GoldAccent}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          BlurRadius="42"
                                          ShadowDepth="9"
                                          Opacity="0.72"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="600"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="600"/>
                            <ColumnDefinition Width="25"/>
                        </Grid.ColumnDefinitions>

                        <!-- Coordenadas Superiores -->
                        <UniformGrid Grid.Row="0"
                                     Grid.Column="1"
                                     Columns="8">
                            <TextBlock Text="A"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="B"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="C"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="D"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="E"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="F"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="G"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="H"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                        </UniformGrid>

                        <!-- Coordenadas Inferiores -->
                        <UniformGrid Grid.Row="2"
                                     Grid.Column="1"
                                     Columns="8">
                            <TextBlock Text="A"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="B"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="C"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="D"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="E"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="F"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="G"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="H"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                        </UniformGrid>

                        <!-- Coordenadas Esquerdas -->
                        <UniformGrid Grid.Row="1"
                                     Grid.Column="0"
                                     Rows="8">
                            <TextBlock Text="8"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="7"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="6"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="5"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="4"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="3"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="2"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="1"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                        </UniformGrid>

                        <!-- Coordenadas Direitas -->
                        <UniformGrid Grid.Row="1"
                                     Grid.Column="2"
                                     Rows="8">
                            <TextBlock Text="8"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="7"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="6"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="5"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="4"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="3"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="2"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                            <TextBlock Text="1"
                                       Style="{StaticResource CoordinateTextStyle}"/>
                        </UniformGrid>

                        <!-- Tabuleiro -->
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BorderBrush="{StaticResource GoldAccent}"
                                BorderThickness="4">
                            <Grid x:Name="BoardGrid"
                                  Background="#160B08"
                                  ClipToBounds="True"/>
                        </Border>
                    </Grid>
                </Border>
            </Viewbox>

            <!-- FOOTER / STATUS -->
            <Grid Grid.Row="2"
                  Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="STATUS DA PARTIDA"
                               Foreground="{StaticResource GoldAccent}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatusText"
                               Text="AGUARDANDO INÍCIO..."
                               Foreground="{StaticResource TextWhite}"
                               FontSize="20"
                               FontFamily="Segoe UI Light"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="NewGameButton"
                            Content="NEW GAME"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="NewGameButton_Click"/>
                    <Button x:Name="ExitButton"
                            Content="EXIT"
                            Style="{StaticResource ModernButtonStyle}"
                            Click="ExitButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>