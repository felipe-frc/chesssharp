<Window x:Class="ChessSharp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChessSharp"
        Width="1100"
        Height="820"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#1f1209">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                    EndPoint="1,1">
                <GradientStop Color="#2a1308"
                        Offset="0"/>
                <GradientStop Color="#5b2410"
                        Offset="0.45"/>
                <GradientStop Color="#140804"
                        Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                <TextBlock Text="♟ ChessSharp"
                           Foreground="#f7d58b"
                           FontSize="36"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Interface gráfica 2D"
                           Foreground="#d4a85f"
                           FontSize="15"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Viewbox Grid.Row="1"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <Border Background="#5a2b12"
                        CornerRadius="16"
                        Padding="16"
                        BorderBrush="#8a4b22"
                        BorderThickness="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24"
                                          ShadowDepth="7"
                                          Opacity="0.5"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <UniformGrid x:Name="TopFilesPanel"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Columns="8"/>

                        <UniformGrid x:Name="LeftRanksPanel"
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     Rows="8"/>

                        <Grid x:Name="BoardGrid"
                              Grid.Row="1"
                              Grid.Column="1"
                              Width="620"
                              Height="620"
                              ClipToBounds="True"/>

                        <UniformGrid x:Name="RightRanksPanel"
                                     Grid.Row="1"
                                     Grid.Column="2"
                                     Rows="8"/>

                        <UniformGrid x:Name="BottomFilesPanel"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Columns="8"/>
                    </Grid>
                </Border>
            </Viewbox>

            <Border Grid.Row="2"
                    Background="#321509"
                    BorderBrush="#8a4b22"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    Width="760">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Column="0"
                               Text="Sua vez."
                               Foreground="#f7d58b"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Nova partida"
                                Width="110"
                                Height="34"
                                Margin="0,0,8,0"
                                Click="NewGameButton_Click"/>

                        <Button Content="Sair"
                                Width="70"
                                Height="34"
                                Click="ExitButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>