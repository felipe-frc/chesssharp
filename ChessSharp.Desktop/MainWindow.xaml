<Window x:Class="ChessSharp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChessSharp - Premium Edition"
        Width="1200"
        Height="850"
        MinWidth="1000"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#050403"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

        <Window.Resources>
                <!-- Paleta -->
                <SolidColorBrush x:Key="GoldAccent"
                                Color="#D6A23F"/>
                <SolidColorBrush x:Key="GoldSoft"
                                Color="#E0B85C"/>
                <SolidColorBrush x:Key="BronzeSoft"
                                Color="#9A6A2E"/>
                <SolidColorBrush x:Key="TextWhite"
                                Color="#F3E7D5"/>
                <SolidColorBrush x:Key="TextMuted"
                                Color="#D7C5A2"/>

                <!-- Botão premium -->
                <Style x:Key="PremiumFooterButtonStyle"
                                TargetType="Button">
                        <Setter Property="Foreground"
                                        Value="{StaticResource TextWhite}"/>
                        <Setter Property="Background"
                                        Value="#140C09"/>
                        <Setter Property="BorderBrush"
                                        Value="#8C6630"/>
                        <Setter Property="BorderThickness"
                                        Value="1"/>
                        <Setter Property="FontSize"
                                        Value="14"/>
                        <Setter Property="FontFamily"
                                        Value="Segoe UI"/>
                        <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                        <Setter Property="Cursor"
                                        Value="Hand"/>
                        <Setter Property="Height"
                                        Value="40"/>
                        <Setter Property="Padding"
                                        Value="18,0"/>
                        <Setter Property="Margin"
                                        Value="10,0,0,0"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5"
                                                        SnapsToDevicePixels="True">
                                                        <Border.Effect>
                                                                <DropShadowEffect Color="#D6A23F"
                                                                                  BlurRadius="10"
                                                                                  ShadowDepth="0"
                                                                                  Opacity="0.10"/>
                                                        </Border.Effect>

                                                        <Grid ClipToBounds="True">
                                                                <Rectangle VerticalAlignment="Top"
                                                                           Height="1"
                                                                           Margin="8,0,8,0"
                                                                           Opacity="0.85">
                                                                        <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                                EndPoint="1,0">
                                                                                        <GradientStop Color="#00FFFFFF"
                                                                                                        Offset="0"/>
                                                                                        <GradientStop Color="#55E0B85C"
                                                                                                        Offset="0.5"/>
                                                                                        <GradientStop Color="#00FFFFFF"
                                                                                                        Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                        </Rectangle.Fill>
                                                                </Rectangle>

                                                                <Rectangle RadiusX="5"
                                                                                RadiusY="5"
                                                                                Opacity="0.25">
                                                                        <Rectangle.Fill>
                                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                                EndPoint="1,1">
                                                                                        <GradientStop Color="#18FFFFFF"
                                                                                                        Offset="0"/>
                                                                                        <GradientStop Color="#001A0B07"
                                                                                                        Offset="0.45"/>
                                                                                        <GradientStop Color="#22D6A23F"
                                                                                                        Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                        </Rectangle.Fill>
                                                                </Rectangle>

                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                        </Grid>
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                                Property="Background"
                                                                                Value="#22120D"/>
                                                                <Setter TargetName="ButtonBorder"
                                                                                Property="BorderBrush"
                                                                                Value="{StaticResource GoldAccent}"/>
                                                                <Setter Property="Foreground"
                                                                                Value="{StaticResource GoldSoft}"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed"
                                                                        Value="True">
                                                                <Setter TargetName="ButtonBorder"
                                                                                Property="Background"
                                                                                Value="#2E1911"/>
                                                                <Setter Property="Foreground"
                                                                                Value="#FFF1C2"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>
        </Window.Resources>

        <Grid>
                <!-- Background -->
                <Grid.Background>
                        <ImageBrush ImageSource="/Assets/Images/background-marble.png"
                                    Stretch="UniformToFill"
                                    AlignmentX="Center"
                                    AlignmentY="Center"/>
                </Grid.Background>

                <!-- Camada escura -->
                <Rectangle Fill="#66000000"
                                IsHitTestVisible="False"/>

                <!-- Vinheta -->
                <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                                <RadialGradientBrush Center="0.5,0.42"
                                                     RadiusX="0.95"
                                                     RadiusY="0.95">
                                        <GradientStop Color="#00000000"
                                                        Offset="0"/>
                                        <GradientStop Color="#33000000"
                                                        Offset="0.62"/>
                                        <GradientStop Color="#99000000"
                                                        Offset="1"/>
                                </RadialGradientBrush>
                        </Rectangle.Fill>
                </Rectangle>

                <!-- Moldura externa -->
                <Border BorderBrush="{StaticResource BronzeSoft}"
                        BorderThickness="0.5"
                        Margin="15"
                        Opacity="0.35"
                        CornerRadius="2"/>

                <Grid Margin="32,22,32,28">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- HEADER -->
                        <StackPanel Grid.Row="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,16,0,20">
                                <Image Source="pack://application:,,,/Assets/Images/logo-chesssharp.png"
                                       Width="300"
                                       Height="82"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                        </StackPanel>

                        <!-- BOARD -->
                        <Viewbox Grid.Row="1"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="0,12,0,0">
                                <Border Padding="0"
                                        Background="#060504"
                                        BorderBrush="{StaticResource GoldAccent}"
                                        BorderThickness="0"
                                        CornerRadius="8">
                                        <Border.Effect>
                                                <DropShadowEffect Color="#D6A23F"
                                                                  BlurRadius="24"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.22"/>
                                        </Border.Effect>

                                        <Grid Width="760"
                                              Height="760"
                                              ClipToBounds="True"
                                              SnapsToDevicePixels="True">

                                                <Image Source="/Assets/Images/board-premium.png"
                                                       Width="760"
                                                       Height="760"
                                                       Stretch="Fill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <Grid x:Name="BoardGrid"
                                                      Width="656"
                                                      Height="656"
                                                      Margin="52,52,52,52"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Background="#01FFFFFF"
                                                      ClipToBounds="True"/>
                                        </Grid>
                                </Border>
                        </Viewbox>

                        <!-- FOOTER -->
                        <Grid Grid.Row="2"
                              Margin="0,18,0,0"
                              HorizontalAlignment="Center">

                                <Border Width="1160"
                                        Height="70"
                                        Background="#D9100908"
                                        BorderBrush="#9A6A2E"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <Border.Effect>
                                                <DropShadowEffect Color="#D6A23F"
                                                                  BlurRadius="14"
                                                                  ShadowDepth="0"
                                                                  Opacity="0.16"/>
                                        </Border.Effect>

                                        <Grid>
                                                <!-- brilho superior -->
                                                <Rectangle Height="1"
                                                           VerticalAlignment="Top"
                                                           Margin="20,0,20,0"
                                                           Opacity="0.85">
                                                        <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0"
                                                                                EndPoint="1,0">
                                                                        <GradientStop Color="#00D6A23F"
                                                                                        Offset="0"/>
                                                                        <GradientStop Color="#FFE0B85C"
                                                                                        Offset="0.5"/>
                                                                        <GradientStop Color="#00D6A23F"
                                                                                        Offset="1"/>
                                                                </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                </Rectangle>

                                                <!-- Conteúdo base -->
                                                <Grid Margin="22,0">
                                                        <!-- STATUS À ESQUERDA -->
                                                        <Grid HorizontalAlignment="Left"
                                                              VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Width="36"
                                                                        Height="36"
                                                                        CornerRadius="18"
                                                                        Background="#1C120D"
                                                                        BorderBrush="#7A5528"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Center">
                                                                        <TextBlock Text="♙"
                                                                                   FontSize="18"
                                                                                   Foreground="{StaticResource GoldSoft}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                </Border>

                                                                <Rectangle Grid.Column="1"
                                                                           Width="1"
                                                                           Height="34"
                                                                           Fill="#45A87A3C"
                                                                           Margin="16,0,18,0"
                                                                           VerticalAlignment="Center"/>

                                                                <StackPanel Grid.Column="2"
                                                                            VerticalAlignment="Center"
                                                                            Width="360">
                                                                        <TextBlock Text="STATUS DA PARTIDA"
                                                                                   Foreground="{StaticResource GoldAccent}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Margin="0,0,0,2"/>

                                                                        <TextBlock x:Name="StatusText"
                                                                                   Text="AGUARDANDO INÍCIO..."
                                                                                   Foreground="{StaticResource TextWhite}"
                                                                                   FontSize="17"
                                                                                   FontFamily="Segoe UI Light"/>
                                                                </StackPanel>
                                                        </Grid>

                                                        <!-- BOTÕES À DIREITA -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                                <Button x:Name="NewGameButton"
                                                                        Style="{StaticResource PremiumFooterButtonStyle}"
                                                                        Click="NewGameButton_Click"
                                                                        MinWidth="165"
                                                                        Width="165"
                                                                        Height="40">
                                                                        <TextBlock Text="NEW GAME"
                                                                                   FontSize="14"
                                                                                   FontWeight="SemiBold"/>
                                                                </Button>

                                                                <Button x:Name="ExitButton"
                                                                        Style="{StaticResource PremiumFooterButtonStyle}"
                                                                        Click="ExitButton_Click"
                                                                        MinWidth="125"
                                                                        Width="125"
                                                                        Height="40">
                                                                        <TextBlock Text="EXIT"
                                                                                   FontSize="14"
                                                                                   FontWeight="SemiBold"/>
                                                                </Button>
                                                        </StackPanel>
                                                </Grid>

                                                <!-- DIVISOR CENTRAL REALMENTE CENTRALIZADO -->
                                                <Grid Width="210"
                                                      Height="34"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Rectangle Grid.Column="0"
                                                                   Height="1"
                                                                   Fill="#66A87A3C"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,14,0"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="♛"
                                                                   Foreground="{StaticResource GoldSoft}"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                                <TextBlock.Effect>
                                                                        <DropShadowEffect Color="#D6A23F"
                                                                                          BlurRadius="8"
                                                                                          ShadowDepth="0"
                                                                                          Opacity="0.30"/>
                                                                </TextBlock.Effect>
                                                        </TextBlock>

                                                        <Rectangle Grid.Column="2"
                                                                   Height="1"
                                                                   Fill="#66A87A3C"
                                                                   VerticalAlignment="Center"
                                                                   Margin="14,0,0,0"/>
                                                </Grid>
                                        </Grid>
                                </Border>
                        </Grid>
                </Grid>
        </Grid>
</Window>