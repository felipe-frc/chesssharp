{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/css/*",
      "/js/*",
      "/lib/*",
      "/sample-data/*",
      "/_framework/*",
      "/favicon.png",
      "/icon-192.png"
    ]
  },
  "mimeTypes": {
    ".wasm": "application/wasm"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
