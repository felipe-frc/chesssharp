@using ChessSharp.Enums

<aside class="info-panel @(IsCollapsed ? "info-panel-collapsed" : string.Empty)">
    @if (IsCollapsed)
    {
        <div class="panel-collapse-rail">
            <button class="panel-collapse-button"
                    type="button"
                    @onclick="OnToggleCollapse"
                    aria-label="Expandir painel lateral"
                    title="Expandir painel lateral">
                <span>❯</span>
            </button>
        </div>
    }
    else
    {
        <section class="card control-panel">
            <div class="panel-top">
                <div class="panel-header-bar">
                    <p class="card-label">Painel da partida</p>

                    <div class="panel-top-tools">
                        <SoundToggle Enabled="SoundEnabled"
                                     Label="@SoundButtonLabel"
                                     OnToggle="OnToggleSound" />
                        <button class="panel-collapse-button"
                                type="button"
                                @onclick="OnToggleCollapse"
                                aria-label="Recolher painel lateral"
                                title="Recolher painel lateral">
                            <span>❮</span>
                        </button>
                    </div>
                </div>

                <div class="panel-heading">
                    <h1>@HeroTitle</h1>
                    <p class="position-summary">@PositionSummary</p>
                </div>
            </div>

            <div class="panel-status-meta">
                @if (!string.IsNullOrWhiteSpace(AlertBadgeText))
                {
                    <span class="@AlertBadgeClass">@AlertBadgeText</span>
                }

                @if (!string.IsNullOrWhiteSpace(MoveCounterLabel))
                {
                    <span class="panel-counter">@MoveCounterLabel</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="panel-status">
                    <span class="@StatusOrbClass"></span>
                    <span>@StatusMessage</span>
                </div>
            }

            <div class="sidebar-actions">
                <button class="footer-button footer-button-primary" @onclick="OnNewGame">
                    Novo jogo
                </button>
                <button class="footer-button" @onclick="OnChangeColor">
                    Trocar cor
                </button>
            </div>

            <div class="panel-block panel-block-soft">
                <div class="panel-inline-title">Você vs Bot</div>

                <div class="sidebar-versus sidebar-versus-compact">
                    <div class="@PlayerSidebarClass">
                        <ChessPiece PieceType="PieceType.King"
                                    PieceColor="PlayerColor"
                                    CssClass="sidebar-player-piece"
                                    AltText="Seu rei" />
                        <strong>Você <span>(@ChessPresentationService.GetColorName(PlayerColor))</span></strong>
                    </div>

                    <span class="sidebar-versus-mark">vs</span>

                    <div class="@BotSidebarClass">
                        <ChessPiece PieceType="PieceType.King"
                                    PieceColor="BotColor"
                                    CssClass="sidebar-player-piece"
                                    AltText="Rei do bot" />
                        <strong>Bot <span>(@ChessPresentationService.GetColorName(BotColor))</span></strong>
                    </div>
                </div>
            </div>

            <div class="panel-block panel-block-soft">
                <div class="summary-lines">
                    <div class="summary-line">
                        <span>Fase</span>
                        <strong>@PhaseLabel</strong>
                    </div>
                    <div class="summary-line">
                        <span>Turno</span>
                        <strong>@TurnOwner</strong>
                    </div>
                    <div class="summary-line">
                        <span>Rei</span>
                        <strong>@KingSafetyLabel</strong>
                    </div>
                    <div class="summary-line">
                        <span>Material</span>
                        <strong>@MaterialSummary</strong>
                    </div>
                    <div class="summary-line">
                        <span>Avaliação</span>
                        <strong>@PositionEvaluation</strong>
                    </div>
                </div>
            </div>

            <div class="panel-block panel-block-soft @(HasCapturedPieces ? string.Empty : "panel-block-empty-mobile")">
                <p class="card-label">Material capturado</p>
                <CapturedPieces CapturedByWhitePieces="CapturedByWhitePieces"
                                CapturedByBlackPieces="CapturedByBlackPieces" />
            </div>

            <div class="panel-block panel-block-soft @(HasHistory ? string.Empty : "panel-block-empty-mobile")">
                <MoveHistory Entries="RecentHistory"
                             ShowOpenButton="@HasHistory"
                             OnOpenFullHistory="OnOpenHistoryModal" />
            </div>
        </section>
    }
</aside>

@code {
    [Parameter]
    public string HeroTitle { get; set; } = string.Empty;

    [Parameter]
    public string PositionSummary { get; set; } = string.Empty;

    [Parameter]
    public string StatusMessage { get; set; } = string.Empty;

    [Parameter]
    public string StatusOrbClass { get; set; } = "status-orb";

    [Parameter]
    public string? AlertBadgeText { get; set; }

    [Parameter]
    public string AlertBadgeClass { get; set; } = "status-badge";

    [Parameter]
    public string MoveCounterLabel { get; set; } = string.Empty;

    [Parameter]
    public bool SoundEnabled { get; set; }

    [Parameter]
    public string SoundButtonLabel { get; set; } = "Som";

    [Parameter]
    public PieceColor PlayerColor { get; set; }

    [Parameter]
    public PieceColor BotColor { get; set; }

    [Parameter]
    public string PlayerSidebarClass { get; set; } = "sidebar-player";

    [Parameter]
    public string BotSidebarClass { get; set; } = "sidebar-player";

    [Parameter]
    public string PhaseLabel { get; set; } = string.Empty;

    [Parameter]
    public string TurnOwner { get; set; } = string.Empty;

    [Parameter]
    public string KingSafetyLabel { get; set; } = string.Empty;

    [Parameter]
    public string MaterialSummary { get; set; } = string.Empty;

    [Parameter]
    public string PositionEvaluation { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<CapturedPieceView> CapturedByWhitePieces { get; set; } = Array.Empty<CapturedPieceView>();

    [Parameter, EditorRequired]
    public IReadOnlyList<CapturedPieceView> CapturedByBlackPieces { get; set; } = Array.Empty<CapturedPieceView>();

    [Parameter, EditorRequired]
    public IReadOnlyList<MoveHistoryEntry> RecentHistory { get; set; } = Array.Empty<MoveHistoryEntry>();

    [Parameter]
    public bool HasHistory { get; set; }

    private bool HasCapturedPieces =>
        CapturedByWhitePieces.Count > 0 || CapturedByBlackPieces.Count > 0;

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnNewGame { get; set; }

    [Parameter]
    public EventCallback OnChangeColor { get; set; }

    [Parameter]
    public EventCallback OnToggleSound { get; set; }

    [Parameter]
    public EventCallback OnOpenFullHistory { get; set; }

    [Parameter]
    public EventCallback OnOpenHistoryModal { get; set; }

    [Parameter]
    public EventCallback OnToggleCollapse { get; set; }
}
