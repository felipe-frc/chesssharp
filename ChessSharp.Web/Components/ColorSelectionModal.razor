@using ChessSharp.Enums

<div class="overlay">
    <div class="modal-card">
        <p class="card-label">Escolha sua cor</p>
        <h2>Quem faz a primeira jogada?</h2>

        <div class="choice-grid">
            <button class="choice-button" @onclick="() => OnColorSelected.InvokeAsync(PieceColor.White)">
                <ChessPiece PieceType="PieceType.King"
                            PieceColor="PieceColor.White"
                            CssClass="choice-image"
                            AltText="Rei branco" />
                <span class="choice-title">Brancas</span>
                <span class="choice-copy">Voce comeca a partida.</span>
            </button>

            <button class="choice-button" @onclick="() => OnColorSelected.InvokeAsync(PieceColor.Black)">
                <ChessPiece PieceType="PieceType.King"
                            PieceColor="PieceColor.Black"
                            CssClass="choice-image"
                            AltText="Rei preto" />
                <span class="choice-title">Pretas</span>
                <span class="choice-copy">O bot abre a partida.</span>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public EventCallback<PieceColor> OnColorSelected { get; set; }
}
