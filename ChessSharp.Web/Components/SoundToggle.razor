<button class="sound-toggle-chip @(Enabled ? "sound-toggle-on" : string.Empty)"
        type="button"
        @onclick="OnToggle"
        title="@Label"
        aria-label="@Label">
    <span class="sound-toggle-glyph">@(Enabled ? "🔊" : "🔇")</span>
</button>

@code {
    [Parameter]
    public bool Enabled { get; set; }

    [Parameter]
    public string Label { get; set; } = "Som";

    [Parameter]
    public EventCallback OnToggle { get; set; }
}
