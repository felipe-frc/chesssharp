<div class="captures-group captures-group-compact @((CapturedByWhitePieces.Count == 0 && CapturedByBlackPieces.Count == 0) ? "captures-group-empty" : string.Empty)">
    <div class="capture-panel capture-panel-inline">
        <div class="capture-heading">
            <span>Capturadas pelas Brancas (@CapturedByWhitePieces.Count)</span>
        </div>
        @if (CapturedByWhitePieces.Count > 0)
        {
            <div class="captured-strip">
                @foreach (var capturedPiece in CapturedByWhitePieces)
                {
                    <ChessPiece PieceType="capturedPiece.PieceType"
                                PieceColor="capturedPiece.PieceColor"
                                CssClass="captured-piece"
                                AltText="@ChessPresentationService.GetPieceTypeName(capturedPiece.PieceType)" />
                }
            </div>
        }
    </div>

    <div class="capture-panel capture-panel-inline">
        <div class="capture-heading">
            <span>Capturadas pelas Pretas (@CapturedByBlackPieces.Count)</span>
        </div>
        @if (CapturedByBlackPieces.Count > 0)
        {
            <div class="captured-strip">
                @foreach (var capturedPiece in CapturedByBlackPieces)
                {
                    <ChessPiece PieceType="capturedPiece.PieceType"
                                PieceColor="capturedPiece.PieceColor"
                                CssClass="captured-piece"
                                AltText="@ChessPresentationService.GetPieceTypeName(capturedPiece.PieceType)" />
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CapturedPieceView> CapturedByWhitePieces { get; set; } = Array.Empty<CapturedPieceView>();

    [Parameter, EditorRequired]
    public IReadOnlyList<CapturedPieceView> CapturedByBlackPieces { get; set; } = Array.Empty<CapturedPieceView>();
}
