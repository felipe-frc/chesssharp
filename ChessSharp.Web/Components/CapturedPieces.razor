@using ChessSharp.Enums

<div class="captures-group captures-group-compact">
    <div class="capture-panel capture-panel-inline">
        <div class="capture-heading">
            <span>Brancas (@WhiteCapturedPieces.Count)</span>
        </div>
        @if (WhiteCapturedPieces.Count > 0)
        {
            <div class="captured-strip">
                @foreach (var capturedPiece in WhiteCapturedPieces)
                {
                    <ChessPiece PieceType="capturedPiece.PieceType"
                                PieceColor="capturedPiece.PieceColor"
                                CssClass="captured-piece"
                                AltText="@ChessPresentationService.GetPieceTypeName(capturedPiece.PieceType)" />
                }
            </div>
        }
    </div>

    <div class="capture-panel capture-panel-inline">
        <div class="capture-heading">
            <span>Pretas (@BlackCapturedPieces.Count)</span>
        </div>
        @if (BlackCapturedPieces.Count > 0)
        {
            <div class="captured-strip">
                @foreach (var capturedPiece in BlackCapturedPieces)
                {
                    <ChessPiece PieceType="capturedPiece.PieceType"
                                PieceColor="capturedPiece.PieceColor"
                                CssClass="captured-piece"
                                AltText="@ChessPresentationService.GetPieceTypeName(capturedPiece.PieceType)" />
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CapturedPieceView> WhiteCapturedPieces { get; set; } = Array.Empty<CapturedPieceView>();

    [Parameter, EditorRequired]
    public IReadOnlyList<CapturedPieceView> BlackCapturedPieces { get; set; } = Array.Empty<CapturedPieceView>();
}
