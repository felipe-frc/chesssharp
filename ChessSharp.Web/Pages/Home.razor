@page "/"

<PageTitle>ChessSharp no navegador</PageTitle>

<div class="web-shell">
    <header class="brand-header">
        <img class="brand-logo" src="assets/images/logo-chesssharp.png" alt="ChessSharp" />
        <p class="brand-subtitle">A mesma engine premium agora roda no navegador com Blazor WebAssembly.</p>
    </header>

    <div class="play-surface">
        <ChessBoard Board="_game.Board"
                    PlayerColor="_playerColor"
                    DisplayRows="DisplayRows"
                    DisplayColumns="DisplayColumns"
                    IsLastMoveSquare="IsLastMoveSquare"
                    IsSelected="IsSelected"
                    IsCheckedKingSquare="IsCheckedKingSquare"
                    IsLegalTarget="IsLegalTarget"
                    IsCaptureTarget="IsCaptureTarget"
                    GetSquareClass="GetSquareClass"
                    GetPieceFrameClass="GetPieceFrameClass"
                    GetBoardNotation="GetBoardNotation"
                    OnSquareClicked="OnSquareClickedAsync" />

        <GamePanel HeroTitle="@GetHeroPanelTitle()"
                   PositionSummary="@GetPositionSummary()"
                   StatusMessage="@_statusMessage"
                   StatusOrbClass="@GetStatusOrbClass()"
                   SoundEnabled="_soundEnabled"
                   SoundButtonLabel="@GetSoundButtonLabel()"
                   PlayerColor="_playerColor"
                   BotColor="_bot.BotColor"
                   PlayerSidebarClass="@GetSidebarPlayerClass(_playerColor)"
                   BotSidebarClass="@GetSidebarPlayerClass(_bot.BotColor)"
                   PhaseLabel="@GetPhaseLabel()"
                   TurnOwner="@GetTurnOwner()"
                   KingSafetyLabel="@GetKingSafetyLabel()"
                   MaterialSummary="@GetMaterialSummary()"
                   WhiteCapturedPieces="WhiteCapturedPieces"
                   BlackCapturedPieces="BlackCapturedPieces"
                   RecentHistory="RecentHistory"
                   HasHistory="@(_moveHistory.Count > 0)"
                   OnNewGame="PromptForColorSelection"
                   OnChangeColor="PromptForColorSelection"
                   OnToggleSound="ToggleSound"
                   OnOpenHistoryModal="OpenHistoryModal" />
    </div>

    @if (_showHistoryModal)
    {
        <div class="overlay">
            <div class="modal-card history-modal-card">
                <div class="history-modal-head">
                    <div>
                        <p class="card-label">Histórico completo</p>
                        <h2>Todos os lances da partida</h2>
                    </div>
                    <button class="modal-close" @onclick="CloseHistoryModal">Fechar</button>
                </div>

                <MoveHistory Title="Histórico completo"
                             Entries="FullHistory"
                             ListCssClass="history-modal-list" />
            </div>
        </div>
    }

    @if (_showColorSelection)
    {
        <ColorSelectionModal OnColorSelected="StartNewGameAsync" />
    }

    @if (_showPromotionSelection)
    {
        <PromotionModal PlayerColor="_playerColor"
                        PromotionChoices="PromotionChoices"
                        OnPromotionSelected="CompletePromotionAsync" />
    }
</div>
