@page "/"
@using ChessSharp.AI
@using ChessSharp.Board
@using ChessSharp.Enums
@using ChessSharp.Game
@using ChessSharp.Pieces

<PageTitle>ChessSharp no navegador</PageTitle>

<div class="web-shell">
    <header class="brand-header">
        <img class="brand-logo" src="assets/images/logo-chesssharp.png" alt="ChessSharp" />
        <p class="brand-subtitle">A mesma engine premium agora roda no navegador com Blazor WebAssembly.</p>
    </header>

    <div class="play-surface">
        <section class="board-stage">
            <div class="board-chamber">
                <div class="board-art">
                    <img class="board-image" src="assets/images/board-premium.png" alt="Tabuleiro premium" />

                    <div class="board-grid">
                        @foreach (var row in DisplayRows)
                        {
                            @foreach (var column in DisplayColumns)
                            {
                                var position = new BoardPosition(row, column);
                                var piece = _game.Board.GetPieceAt(position);

                                <button class="@GetSquareClass(position)"
                                        @onclick="() => OnSquareClickedAsync(position)">
                                    @if (IsSelected(position))
                                    {
                                        <span class="selected-highlight"></span>
                                    }

                                    @if (IsLastMoveSquare(position))
                                    {
                                        <span class="last-move-highlight"></span>
                                    }

                                    @if (IsCheckedKingSquare(position))
                                    {
                                        <span class="check-highlight"></span>
                                    }

                                    @if (IsLegalTarget(position))
                                    {
                                        <span class="@(IsCaptureTarget(position) ? "move-indicator move-indicator-capture" : "move-indicator")"></span>
                                    }

                                    @if (piece is not null)
                                    {
                                        <img class="piece-image @GetPieceFrameClass(piece, position)"
                                             src="@GetPieceAssetPath(piece.PieceType, piece.PieceColor)"
                                             alt="@GetPieceAltText(piece)"
                                             draggable="false" />
                                    }
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </section>

        <aside class="info-panel">
            <div class="card sidebar-primary">
                <p class="card-label">Painel da partida</p>
                <h1>@GetHeroPanelTitle()</h1>

                <div class="sidebar-status">
                    <span class="@GetStatusOrbClass()"></span>
                    <div class="sidebar-status-copy">
                        <strong>@_statusMessage</strong>
                        <span>@GetStatusSupportText()</span>
                    </div>
                </div>

                <div class="sidebar-actions">
                    <button class="footer-button footer-button-primary" @onclick="PromptForColorSelection">
                        Novo jogo
                    </button>
                    <button class="footer-button" @onclick="PromptForColorSelection">
                        Trocar cor
                    </button>
                </div>

                <div class="sidebar-versus">
                    <div class="sidebar-player">
                        <img class="sidebar-player-piece" src="@GetPieceAssetPath(PieceType.King, _playerColor)" alt="Seu rei" />
                        <div>
                            <strong>Você</strong>
                            <span>@GetColorName(_playerColor)</span>
                        </div>
                    </div>

                    <span class="sidebar-versus-mark">vs</span>

                    <div class="sidebar-player">
                        <img class="sidebar-player-piece" src="@GetPieceAssetPath(PieceType.King, _bot.BotColor)" alt="Rei do bot" />
                        <div>
                            <strong>Bot</strong>
                            <span>@GetColorName(_bot.BotColor)</span>
                        </div>
                    </div>
                </div>

                <div class="sidebar-meta">
                    <span>Sua cor: <strong>@GetColorName(_playerColor)</strong></span>
                    <span>Último lance: <strong>@GetLastMoveLabel()</strong></span>
                </div>
            </div>

            <div class="card sidebar-summary">
                <p class="card-label">Leitura rápida</p>

                <div class="summary-lines">
                    <div class="summary-line">
                        <span>Fase</span>
                        <strong>@GetPhaseLabel()</strong>
                    </div>
                    <div class="summary-line">
                        <span>Turno</span>
                        <strong>@GetTurnOwner()</strong>
                    </div>
                    <div class="summary-line">
                        <span>Rei</span>
                        <strong>@GetKingSafetyLabel()</strong>
                    </div>
                    <div class="summary-line">
                        <span>Material</span>
                        <strong>@GetMaterialSwingLabel()</strong>
                    </div>
                </div>
            </div>

            <div class="card sidebar-secondary">
                <div class="sidebar-secondary-head">
                    <p class="card-label">Histórico recente</p>
                    <p class="sidebar-mini-copy">@GetFlowSummary()</p>
                </div>

                @if (_moveHistory.Count == 0)
                {
                    <p class="card-copy">Nenhum lance registrado ainda. Escolha uma cor para iniciar a partida.</p>
                }
                else
                {
                    <div class="history-list">
                        @foreach (var entry in RecentHistory)
                        {
                            <div class="history-item">
                                <span class="history-line">@entry.Number.ToString("00"). @entry.SideLabel: @entry.Notation</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </aside>
    </div>

    @if (_showColorSelection)
    {
        <div class="overlay">
            <div class="modal-card">
                <p class="card-label">Escolha sua cor</p>
                <h2>Quem faz a primeira jogada?</h2>

                <div class="choice-grid">
                    <button class="choice-button" @onclick="() => StartNewGameAsync(PieceColor.White)">
                        <img class="choice-image"
                             src="@GetPieceAssetPath(PieceType.King, PieceColor.White)"
                             alt="Rei branco" />
                        <span class="choice-title">Brancas</span>
                        <span class="choice-copy">Você começa a partida.</span>
                    </button>

                    <button class="choice-button" @onclick="() => StartNewGameAsync(PieceColor.Black)">
                        <img class="choice-image"
                             src="@GetPieceAssetPath(PieceType.King, PieceColor.Black)"
                             alt="Rei preto" />
                        <span class="choice-title">Pretas</span>
                        <span class="choice-copy">A máquina abre a partida.</span>
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_showPromotionSelection)
    {
        <div class="overlay">
            <div class="modal-card">
                <p class="card-label">Promoção de peão</p>
                <h2>Escolha a peça para concluir a jogada</h2>

                <div class="choice-grid promotion-grid">
                    @foreach (var pieceType in PromotionChoices)
                    {
                        <button class="choice-button"
                                @onclick="() => CompletePromotionAsync(pieceType)">
                            <img class="choice-image"
                                 src="@GetPieceAssetPath(pieceType, _playerColor)"
                                 alt="@GetPieceTypeName(pieceType)" />
                            <span class="choice-title">@GetPieceTypeName(pieceType)</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly PieceType[] PromotionChoices =
    [
        PieceType.Queen,
        PieceType.Rook,
        PieceType.Bishop,
        PieceType.Knight
    ];

    private ChessGame _game = new();
    private ChessBot _bot = new(PieceColor.Black);
    private PieceColor _playerColor = PieceColor.White;
    private BoardPosition? _selectedPosition;
    private List<BoardPosition> _legalTargetPositions = [];
    private string _statusMessage = "Escolha sua cor para começar.";
    private bool _showColorSelection = true;
    private bool _showPromotionSelection;
    private bool _isBotThinking;
    private BoardPosition? _pendingPromotionOrigin;
    private BoardPosition? _pendingPromotionTarget;
    private readonly List<MoveHistoryEntry> _moveHistory = [];

    private IEnumerable<int> DisplayRows =>
        _playerColor == PieceColor.White
            ? Enumerable.Range(0, 8)
            : Enumerable.Range(0, 8).Reverse();

    private IEnumerable<int> DisplayColumns =>
        _playerColor == PieceColor.White
            ? Enumerable.Range(0, 8)
            : Enumerable.Range(0, 8).Reverse();

    private IEnumerable<MoveHistoryEntry> RecentHistory =>
        _moveHistory.TakeLast(8).Reverse();

    private async Task OnSquareClickedAsync(BoardPosition clickedPosition)
    {
        if (_showColorSelection || _showPromotionSelection || _isBotThinking || _game.IsFinished)
            return;

        if (_game.CurrentTurn != _playerColor)
            return;

        if (_selectedPosition is null)
        {
            SelectPiece(clickedPosition);
            return;
        }

        if (_selectedPosition.Value == clickedPosition)
        {
            ClearSelection();
            _statusMessage = GetPlayerTurnMessage();
            return;
        }

        var clickedPiece = _game.Board.GetPieceAt(clickedPosition);

        if (clickedPiece is not null &&
            clickedPiece.PieceColor == _playerColor &&
            !_legalTargetPositions.Contains(clickedPosition))
        {
            SelectPiece(clickedPosition);
            return;
        }

        if (!_legalTargetPositions.Contains(clickedPosition))
        {
            _statusMessage = GetInvalidTargetMessage();
            return;
        }

        await TryMoveSelectedPieceAsync(clickedPosition);
    }

    private void SelectPiece(BoardPosition position)
    {
        var piece = _game.Board.GetPieceAt(position);

        if (piece is null || piece.PieceColor != _playerColor)
        {
            ClearSelection();
            _statusMessage = piece is null
                ? "Escolha uma peça sua."
                : $"Você joga com as peças {GetColorName(_playerColor).ToLowerInvariant()}.";
            return;
        }

        _selectedPosition = position;
        _legalTargetPositions = ChessRules
            .GetLegalMoves(_game.Board, _playerColor)
            .Where(move => move.Origin == position)
            .Select(move => move.Target)
            .Distinct()
            .ToList();

        if (_legalTargetPositions.Count == 0)
        {
            _statusMessage = ChessRules.IsKingInCheck(_game.Board, _playerColor)
                ? "Rei em perigo. Escolha outra peça para se defender."
                : "Essa peça não possui movimentos válidos.";
            return;
        }

        _statusMessage = "Escolha uma casa destacada para mover.";
    }

    private async Task TryMoveSelectedPieceAsync(BoardPosition targetPosition)
    {
        if (_selectedPosition is null)
            return;

        var origin = _selectedPosition.Value;
        var movingPiece = _game.Board.GetPieceAt(origin);

        if (movingPiece is null)
            return;

        if (ChessRules.IsPawnPromotionMove(movingPiece, targetPosition))
        {
            _pendingPromotionOrigin = origin;
            _pendingPromotionTarget = targetPosition;
            _showPromotionSelection = true;
            _statusMessage = "Escolha a peça da promoção.";
            return;
        }

        await ExecutePlayerMoveAsync(new Move(origin, targetPosition));
    }

    private async Task CompletePromotionAsync(PieceType pieceType)
    {
        if (_pendingPromotionOrigin is null || _pendingPromotionTarget is null)
            return;

        _showPromotionSelection = false;

        var move = new Move(
            _pendingPromotionOrigin.Value,
            _pendingPromotionTarget.Value,
            pieceType);

        _pendingPromotionOrigin = null;
        _pendingPromotionTarget = null;

        await ExecutePlayerMoveAsync(move);
    }

    private async Task ExecutePlayerMoveAsync(Move move)
    {
        var result = _game.TryMove(move);
        ClearSelection();

        if (!result.Success)
        {
            _statusMessage = GetInvalidTargetMessage();
            return;
        }

        RegisterMoveHistory(move, _playerColor);

        if (_game.IsFinished)
        {
            _statusMessage = GetFinalMessage();
            return;
        }

        _statusMessage = "Movimento realizado. A máquina está pensando...";
        await MakeBotMoveAsync();
    }

    private async Task MakeBotMoveAsync()
    {
        if (_game.CurrentTurn != _bot.BotColor)
            return;

        _isBotThinking = true;
        _statusMessage = $"A máquina está jogando com as peças {GetColorName(_bot.BotColor).ToLowerInvariant()}...";

        await Task.Delay(300);

        try
        {
            var botMove = _bot.ChooseMove(_game.Board);

            if (botMove is null)
            {
                _statusMessage = "Oponente sem movimentos disponíveis.";
                return;
            }

            var botMoveResult = _game.TryMove(botMove.Value);

            if (!botMoveResult.Success)
            {
                _statusMessage = "A máquina tentou uma jogada inválida.";
                return;
            }

            RegisterMoveHistory(botMove.Value, _bot.BotColor);

            _statusMessage = _game.IsFinished
                ? GetFinalMessage()
                : GetPlayerTurnMessage();
        }
        finally
        {
            _isBotThinking = false;
        }
    }

    private async Task StartNewGameAsync(PieceColor playerColor)
    {
        _showColorSelection = false;
        _showPromotionSelection = false;
        _pendingPromotionOrigin = null;
        _pendingPromotionTarget = null;
        _playerColor = playerColor;
        _game = new ChessGame();
        _bot = new ChessBot(ChessRules.GetOpponentColor(playerColor));
        _moveHistory.Clear();
        ClearSelection();

        _statusMessage = GetPlayerTurnMessage();

        if (_game.CurrentTurn != _playerColor)
            await MakeBotMoveAsync();
    }

    private void PromptForColorSelection()
    {
        _showPromotionSelection = false;
        _pendingPromotionOrigin = null;
        _pendingPromotionTarget = null;
        ClearSelection();
        _showColorSelection = true;
        _statusMessage = "Escolha sua cor para iniciar uma nova partida.";
    }

    private void ClearSelection()
    {
        _selectedPosition = null;
        _legalTargetPositions.Clear();
    }

    private string GetPlayerTurnMessage() =>
        ChessRules.IsKingInCheck(_game.Board, _playerColor)
            ? "Seu rei está em xeque."
            : "Sua vez de jogar.";

    private string GetInvalidTargetMessage() =>
        ChessRules.IsKingInCheck(_game.Board, _playerColor)
            ? "Movimento inválido. Você precisa sair do xeque."
            : "Escolha uma casa válida para essa jogada.";

    private string GetFinalMessage()
    {
        bool playerWon =
            (_playerColor == PieceColor.White && _game.Status == GameStatus.WhiteWins) ||
            (_playerColor == PieceColor.Black && _game.Status == GameStatus.BlackWins);

        return _game.Status switch
        {
            GameStatus.WhiteWins or GameStatus.BlackWins => playerWon
                ? "Vitória. Você venceu a partida."
                : "Derrota. O oponente venceu.",
            GameStatus.Draw => "Empate por afogamento.",
            GameStatus.PlayerQuit => "Partida encerrada.",
            _ => "Jogo finalizado."
        };
    }

    private string GetTurnOwner() =>
        _game.CurrentTurn == _playerColor ? "Você" : "Máquina";

    private string GetStatusSupportText()
    {
        if (_showColorSelection)
            return "Defina a cor da próxima partida.";

        if (_showPromotionSelection)
            return "Promoção pendente. Escolha a peça para concluir o lance.";

        if (_isBotThinking)
            return "A engine está calculando localmente no navegador.";

        if (_game.IsFinished)
            return "Partida encerrada. Você pode iniciar outra rodada.";

        return _game.CurrentTurn == _playerColor
            ? "Selecione uma peça da sua cor e escolha um destino válido."
            : "Aguarde a resposta do bot.";
    }

    private string GetKingSafetyLabel() =>
        ChessRules.IsKingInCheck(_game.Board, _playerColor) ? "Em xeque" : "Protegido";

    private bool IsSelected(BoardPosition position) =>
        _selectedPosition is not null && _selectedPosition.Value == position;

    private bool IsLegalTarget(BoardPosition position) =>
        _legalTargetPositions.Contains(position);

    private bool IsCaptureTarget(BoardPosition position)
    {
        var piece = _game.Board.GetPieceAt(position);
        return piece is not null && piece.PieceColor != _playerColor;
    }

    private bool IsLastMoveSquare(BoardPosition position)
    {
        if (_game.Board.LastMove is null)
            return false;

        var move = _game.Board.LastMove.Value;
        return move.Origin == position || move.Target == position;
    }

    private bool IsCheckedKingSquare(BoardPosition position)
    {
        if (!ChessRules.IsKingInCheck(_game.Board, _game.CurrentTurn))
            return false;

        var kingPosition = _game.Board.FindKingPosition(_game.CurrentTurn);
        return kingPosition is not null && kingPosition.Value == position;
    }

    private string GetSquareClass(BoardPosition position)
    {
        var classes = new List<string> { "board-square" };

        if (IsSelected(position))
            classes.Add("board-square-selected");

        return string.Join(" ", classes);
    }

    private string GetPieceFrameClass(ChessPiece piece, BoardPosition position)
    {
        var classes = new List<string>
        {
            piece.PieceType switch
            {
                PieceType.Pawn => "piece-pawn",
                PieceType.Rook => "piece-rook",
                PieceType.Knight => "piece-knight",
                PieceType.Bishop => "piece-bishop",
                PieceType.Queen => "piece-queen",
                PieceType.King => "piece-king",
                _ => string.Empty
            }
        };

        if (IsBottomDisplayRow(position))
            classes.Add("piece-edge-bottom");
        else if (IsTopDisplayRow(position))
            classes.Add("piece-edge-top");

        return string.Join(" ", classes);
    }

    private bool IsTopDisplayRow(BoardPosition position) =>
        _playerColor == PieceColor.White ? position.Row == 0 : position.Row == 7;

    private bool IsBottomDisplayRow(BoardPosition position) =>
        _playerColor == PieceColor.White ? position.Row == 7 : position.Row == 0;

    private string GetStatusOrbClass()
    {
        var classes = new List<string> { "status-orb" };

        if (_showColorSelection || _showPromotionSelection)
            classes.Add("status-orb-attention");
        else if (_isBotThinking)
            classes.Add("status-orb-thinking");
        else if (_game.IsFinished)
            classes.Add("status-orb-finished");
        else if (ChessRules.IsKingInCheck(_game.Board, _playerColor))
            classes.Add("status-orb-alert");
        else
            classes.Add("status-orb-ready");

        return string.Join(" ", classes);
    }

    private static string GetPieceAssetPath(PieceType pieceType, PieceColor color)
    {
        string colorName = color == PieceColor.White ? "white" : "black";

        string pieceName = pieceType switch
        {
            PieceType.King => "king",
            PieceType.Queen => "queen",
            PieceType.Rook => "rook",
            PieceType.Bishop => "bishop",
            PieceType.Knight => "knight",
            PieceType.Pawn => "pawn",
            _ => throw new InvalidOperationException("Tipo de peça inválido.")
        };

        return $"assets/images/pieces/{colorName}-{pieceName}.png";
    }

    private static string GetPieceAltText(ChessPiece piece) =>
        $"{GetPieceTypeName(piece.PieceType)} {(piece.PieceColor == PieceColor.White ? "branco" : "preto")}";

    private string GetLastMoveLabel()
    {
        if (_game.Board.LastMove is null)
            return "Aguardando abertura";

        var move = _game.Board.LastMove.Value;
        return $"{GetBoardNotation(move.Origin)} -> {GetBoardNotation(move.Target)}";
    }

    private string GetFlowSummary()
    {
        if (_moveHistory.Count == 0)
            return "A partida começa assim que você escolher uma cor.";

        if (_game.IsFinished)
            return "Sequência final disponível para revisão.";

        if (ChessRules.IsKingInCheck(_game.Board, _game.CurrentTurn))
            return "O lado da vez está em xeque.";

        return _game.CurrentTurn == _playerColor
            ? "Seu turno está ativo."
            : "O bot está calculando a resposta.";
    }

    private string GetHeroPanelTitle()
    {
        if (_showColorSelection)
            return "Escolha o lado.";

        if (_game.IsFinished)
            return "Partida encerrada.";

        return _game.CurrentTurn == _playerColor
            ? "Sua vez."
            : "Bot pensando.";
    }

    private string GetPhaseLabel()
    {
        if (_moveHistory.Count < 8)
            return "Abertura";

        if (_moveHistory.Count < 24)
            return "Meio-jogo";

        return "Final";
    }

    private string GetMaterialSwingLabel()
    {
        int delta = GetMaterialDelta(_playerColor);

        if (delta > 0)
            return $"+{delta} para você";

        if (delta < 0)
            return $"{delta} para você";

        return "Igualado";
    }

    private int GetMaterialDelta(PieceColor perspective)
    {
        int own = GetMaterialScore(perspective);
        int opponent = GetMaterialScore(ChessRules.GetOpponentColor(perspective));
        return own - opponent;
    }

    private int GetMaterialScore(PieceColor color)
    {
        int total = 0;

        for (int row = 0; row < 8; row++)
        {
            for (int column = 0; column < 8; column++)
            {
                var piece = _game.Board.GetPieceAt(new BoardPosition(row, column));

                if (piece?.PieceColor != color)
                    continue;

                total += piece.PieceType switch
                {
                    PieceType.Pawn => 1,
                    PieceType.Knight => 3,
                    PieceType.Bishop => 3,
                    PieceType.Rook => 5,
                    PieceType.Queen => 9,
                    _ => 0
                };
            }
        }

        return total;
    }

    private static string GetBoardNotation(BoardPosition position) =>
        $"{(char)('a' + position.Column)}{8 - position.Row}";

    private void RegisterMoveHistory(Move move, PieceColor side)
    {
        _moveHistory.Add(new MoveHistoryEntry(
            _moveHistory.Count + 1,
            side == _playerColor ? "Você" : "Bot",
            BuildMoveNotation(move)));
    }

    private string BuildMoveNotation(Move move)
    {
        string notation = $"{GetBoardNotation(move.Origin)} -> {GetBoardNotation(move.Target)}";

        if (move.PromotionPieceType is not null)
            notation += $" = {GetPieceTypeName(move.PromotionPieceType.Value)}";

        return notation;
    }

    private static string GetColorName(PieceColor color) =>
        color == PieceColor.White ? "Brancas" : "Pretas";

    private static string GetPieceTypeName(PieceType pieceType) =>
        pieceType switch
        {
            PieceType.Queen => "Rainha",
            PieceType.Rook => "Torre",
            PieceType.Bishop => "Bispo",
            PieceType.Knight => "Cavalo",
            PieceType.King => "Rei",
            PieceType.Pawn => "Peão",
            _ => pieceType.ToString()
        };

    private sealed record MoveHistoryEntry(int Number, string SideLabel, string Notation);
}
